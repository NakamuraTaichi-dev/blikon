# Public: set to true on Vercel after the Blikon backend API is ready.
NEXT_PUBLIC_BACKEND_ENABLED=false

# Server-only. Never expose these to the browser.
BACKEND_API_URL=https://portalfoliosdigitales.blikon.com
BACKEND_API_PREFIX=/api
BACKEND_API_KEY=
BACKEND_API_TIMEOUT_MS=12000

# Optional path overrides if the backend uses different routes.
BACKEND_PATH_LOGIN=/auth/login
BACKEND_PATH_REGISTER=/auth/register
BACKEND_PATH_LOGOUT=/auth/logout
BACKEND_PATH_SESSION=/auth/session
BACKEND_PATH_TICKETS=/tickets
BACKEND_PATH_TICKET_LOOKUP=/tickets/lookup
BACKEND_PATH_ORDERS=/orders
BACKEND_PATH_PV_LEAD=/leads/punto-venta
